#!/bin/bash
set -e

# Cache-bust: bump the date on this line whenever you want Binder to rebuild
# against fresh ppm/ source. Binder caches images by the content hash of
# the spec files (this script + requirements.txt + runtime.txt). Editing
# any byte invalidates the cache and forces a rebuild on next launch
# (3-5 min). Without a bump, Binder serves the cached image and the
# installed ppm package stays frozen at whatever was current at last build.
# Last bump: 2026-05-09

# Install the ppm package so it's importable in Binder sessions
pip install --no-deps .

# Enable Voilà and ipywidgets explicitly. repo2docker handles this on
# its own for most setups; the explicit enables make the dependency
# obvious and are harmless if redundant.
jupyter server extension enable voila --sys-prefix
jupyter nbextension enable --py widgetsnbextension --sys-prefix
